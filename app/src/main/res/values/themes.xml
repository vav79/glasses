<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная тема окна; цвета интерфейса задаёт Compose (GlassesTheme, Material You). -->
    <style name="Theme.Glasses" parent="android:Theme.Material.NoActionBar" />

    <!-- Заставка при запуске (SplashScreen API): иконка приложения на её фоне. -->
    <style name="Theme.Glasses.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Glasses</item>
    </style>
</resources>
