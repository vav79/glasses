<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Основная тема окна. MainActivity — AppCompatActivity (нужна для per-app language на Android 10–12),
      поэтому тема — потомок Theme.AppCompat. Цвета интерфейса задаёт Compose (GlassesTheme, Material You).
    -->
    <style name="Theme.Glasses" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!--
      Заставка при запуске (SplashScreen API). installSplashScreen() вызывается до super.onCreate и сразу
      ставит postSplashScreenTheme — проверка темы AppCompatActivity видит уже Theme.Glasses.
      Фон всегда чёрный: следом идёт видеозаставка (начинается с чёрного кадра) и тёмная тема по умолчанию.
    -->
    <style name="Theme.Glasses.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_dark</item>
        <!-- Иконка целиком, с её тёмным фоном: чёрные очки переднего слоя на чёрной заставке не видны. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Glasses</item>
    </style>
</resources>
