<?xml version="1.0" encoding="utf-8"?>
<!-- Только debug-сборка: витрина вариантов иконок. exported — чтобы открывать через adb am start. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.ShowcaseActivity"
            android:exported="true"
            android:label="Витрина иконок"
            android:theme="@style/Theme.Glasses" />
        <!-- Проба DAT Speech на очках: adb shell am start -n ru.vasev.glasses/.debug.SpeechProbeActivity -->
        <!-- Проба жестов очков (DAT Inputs и медиакнопки): adb shell am start -n ru.vasev.glasses/.debug.InputsProbeActivity -->
        <activity
            android:name=".debug.InputsProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.Glasses" />
        <!-- Проба: слышит ли микрофон очков собеседника на 1–2 м: adb shell am start -n ru.vasev.glasses/.debug.MicProbeActivity -->
        <activity
            android:name=".debug.MicProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.Glasses" />
        <activity
            android:name=".debug.SpeechProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.Glasses" />
    </application>
</manifest>
