#!/bin/sh
# Не даёт закоммитить ключ или токен: gitleaks проверяет то, что подготовлено к коммиту.
# Включить один раз в клоне: git config core.hooksPath .githooks
# Установить gitleaks: https://github.com/gitleaks/gitleaks/releases (или winget install gitleaks).

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --no-banner || {
        echo "pre-commit: gitleaks нашёл похожее на секрет. Уберите его из коммита (ключи — только в local.properties или в приложении)." >&2
        exit 1
    }
else
    # Без gitleaks — простая проверка самых частых ключей.
    if git diff --cached -U0 | grep -E '^\+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|gh[pousr]_[A-Za-z0-9]{30,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
        echo "pre-commit: в коммите похоже на API-ключ. Уберите его (ключи — только в local.properties или в приложении)." >&2
        exit 1
    fi
    echo "pre-commit: gitleaks не установлен — сделана только простая проверка." >&2
fi
